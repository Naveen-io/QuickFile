<Window x:Class="QuickFile.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickFile Settings" 
        Height="490" Width="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F9F9F9"
        Foreground="#1C1C1C"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif">
    
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI, sans-serif"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D1D1D1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#242424"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F3F3F3"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#C0C0C0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E5E5E5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#0067C0"/>
            <Setter Property="BorderBrush" Value="#005FB8"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#187BD0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#005A9E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="QuickFile" FontSize="20" FontWeight="Bold" Foreground="#111111"/>
            <TextBlock Text="Quick file actions, right from Windows File Explorer." FontSize="12" Foreground="#616161" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Status Card -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E5E5E5" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Explorer Context Menu Integration" FontSize="13" FontWeight="SemiBold" Foreground="#242424"/>
                    <TextBlock x:Name="TxtStatus" Text="Status: Checking..." FontSize="12" Foreground="#666666" Margin="0,2,0,0"/>
                </StackPanel>
                <Button x:Name="BtnToggle" Grid.Column="1" Content="Register" Style="{StaticResource PrimaryButton}" Click="BtnToggle_Click" VerticalAlignment="Center" MinWidth="110"/>
            </Grid>
        </Border>

        <!-- Formats & Capabilities Grid -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E5E5E5" BorderThickness="1" CornerRadius="8" Padding="14">
            <StackPanel>
                <TextBlock Text="Supported Formats &amp; Actions" FontSize="13" FontWeight="SemiBold" Foreground="#242424" Margin="0,0,0,8"/>
                
                <!-- Category 1: Images -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="#E6F2FB" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <TextBlock Text="IMAGES" FontSize="10" FontWeight="Bold" Foreground="#005A9E"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="PNG, JPG, WEBP, BMP, TIFF, GIF • Convert, Compress, Resize, Target Size, Combine to PDF" FontSize="11" Foreground="#444444" TextWrapping="Wrap"/>
                </Grid>

                <!-- Category 2: Audio -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="#F0F7ED" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <TextBlock Text="AUDIO" FontSize="10" FontWeight="Bold" Foreground="#107C41"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="MP3, WAV, FLAC, AAC, M4A, OGG, WMA • Convert, Bitrate (128k–320k), Presets, Channels" FontSize="11" Foreground="#444444" TextWrapping="Wrap"/>
                </Grid>

                <!-- Category 3: Video -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="#FFF4CE" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <TextBlock Text="VIDEO" FontSize="10" FontWeight="Bold" Foreground="#8A6D00"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="MP4, MKV, MOV, WEBM, AVI, WMV • Transcode, 1080p/720p/480p, Extract Audio to MP3" FontSize="11" Foreground="#444444" TextWrapping="Wrap"/>
                </Grid>

                <!-- Category 4: PDF -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="#FDE7E9" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <TextBlock Text="PDF" FontSize="10" FontWeight="Bold" Foreground="#A80000"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="PDF Document Tools • Convert to Images, Split Pages, Extract Pages, Rotate 90°" FontSize="11" Foreground="#444444" TextWrapping="Wrap"/>
                </Grid>

                <Separator Background="#EEEEEE" Margin="0,0,0,8"/>
                
                <TextBlock Text="• Zero background memory when idle (0 MB RAM / 0% CPU)." FontSize="11" Foreground="#0078D4" Margin="0,1"/>
                <TextBlock Text="• 100% local-first, offline, private (no cloud, no tracking, no telemetry)." FontSize="11" Foreground="#0078D4" Margin="0,1"/>
                <TextBlock Text="• Direct Windows 11 context menu bypass (no 'Show more options' click needed)." FontSize="11" Foreground="#0078D4" Margin="0,1"/>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Button Content="Show Sample Image in Explorer" HorizontalAlignment="Left" Click="BtnTestImage_Click" Padding="12,6" FontSize="12"/>
            <Button Content="Close" HorizontalAlignment="Right" Click="BtnClose_Click" MinWidth="75" Padding="12,6" FontSize="12"/>
        </Grid>
    </Grid>
</Window>
