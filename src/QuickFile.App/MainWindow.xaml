<Window x:Class="QuickFile.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickFile Settings" 
        Height="540" Width="540"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="Transparent"
        Foreground="#1C1C1C"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
        WindowStyle="None"
        AllowsTransparency="True">
    
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI, sans-serif"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D6D6D6"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#242424"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F4F4F4"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#BFBFBF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#EAEAEA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#0067C0"/>
            <Setter Property="BorderBrush" Value="#005FB8"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#187BD0"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#1472C0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#005A9E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Elevated Window Card with True Rounded Corners & Move Support -->
    <Border x:Name="RootBorder" 
            Background="#FFFFFF" 
            BorderBrush="#DCDCDC" 
            BorderThickness="1" 
            CornerRadius="18" 
            Padding="22" 
            Margin="12"
            MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" Direction="270" ShadowDepth="5" Opacity="0.22" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Bar -->
                <RowDefinition Height="Auto"/> <!-- Hero / Status -->
                <RowDefinition Height="*"/>    <!-- Format Capabilities -->
                <RowDefinition Height="Auto"/> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- Row 0: Title Bar with Drag Support & Logo -->
            <Grid Grid.Row="0" Margin="0,0,0,16" Background="Transparent" Cursor="SizeAll">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="24" Height="24" CornerRadius="6" Background="#000000" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Image Source="/assets/logo32.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <TextBlock Text="QuickFile" FontSize="13" FontWeight="Bold" Foreground="#111111" VerticalAlignment="Center"/>
                    <Border Background="#F1F3F5" CornerRadius="4" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="v1.1" FontSize="10" FontWeight="SemiBold" Foreground="#6C757D"/>
                    </Border>
                </StackPanel>

                <!-- Window Control Buttons (Minimize & Close) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="—" Click="BtnMinimize_Click" Width="28" Height="28" Padding="0" Margin="0,0,4,0"
                            Background="Transparent" BorderThickness="0" Foreground="#666666" FontSize="10" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#F0F0F0"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="✕" Click="BtnClose_Click" Width="28" Height="28" Padding="0"
                            Background="Transparent" BorderThickness="0" Foreground="#666666" FontSize="12" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#FEEBEB"/>
                                        <Setter Property="Foreground" Value="#C42B1C"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Row 1: Hero & Status Card -->
            <Border Grid.Row="1" Background="#F8F9FA" BorderBrush="#E9ECEF" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Big Logo Emblem -->
                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="12" Background="#000000" Margin="0,0,14,0" VerticalAlignment="Center">
                        <Image Source="/assets/logo.png" Width="42" Height="42" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Context Menu Integration" FontSize="14" FontWeight="Bold" Foreground="#212529"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#107C41" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtStatus" Text="Status: Active in Explorer" FontSize="12" FontWeight="Medium" Foreground="#107C41" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <Button x:Name="BtnToggle" Grid.Column="2" Content="Register" Style="{StaticResource PrimaryButton}" Click="BtnToggle_Click" VerticalAlignment="Center" MinWidth="110"/>
                </Grid>
            </Border>

            <!-- Row 2: Formats & Capabilities Grid -->
            <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E9ECEF" BorderThickness="1" CornerRadius="12" Padding="16">
                <StackPanel>
                    <TextBlock Text="Supported Formats &amp; Actions" FontSize="13" FontWeight="SemiBold" Foreground="#212529" Margin="0,0,0,10"/>
                    
                    <!-- Category 1: Images -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="74"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="#E8F2FA" CornerRadius="5" Padding="7,3" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <TextBlock Text="IMAGES" FontSize="10" FontWeight="Bold" Foreground="#005A9E"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="PNG, JPG, WEBP, BMP, TIFF, GIF • Convert, Compress, Resize, Target Size, Combine to PDF" FontSize="11" Foreground="#495057" TextWrapping="Wrap" LineHeight="16"/>
                    </Grid>

                    <!-- Category 2: Audio -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="74"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="#EAF5EA" CornerRadius="5" Padding="7,3" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <TextBlock Text="AUDIO" FontSize="10" FontWeight="Bold" Foreground="#107C41"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="MP3, WAV, FLAC, AAC, M4A, OGG, WMA • Convert, Bitrates (128k–320k), Presets, Channels" FontSize="11" Foreground="#495057" TextWrapping="Wrap" LineHeight="16"/>
                    </Grid>

                    <!-- Category 3: Video -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="74"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="#FFF4E5" CornerRadius="5" Padding="7,3" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <TextBlock Text="VIDEO" FontSize="10" FontWeight="Bold" Foreground="#C85A00"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="MP4, MKV, MOV, WEBM, AVI, WMV • Transcode, 1080p/720p/480p, Extract Audio to MP3" FontSize="11" Foreground="#495057" TextWrapping="Wrap" LineHeight="16"/>
                    </Grid>

                    <!-- Category 4: PDF -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="74"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="#FEEBEB" CornerRadius="5" Padding="7,3" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <TextBlock Text="PDF" FontSize="10" FontWeight="Bold" Foreground="#C42B1C"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="PDF Document Tools • Convert to Images, Split Pages, Extract Range, Rotate 90°" FontSize="11" Foreground="#495057" TextWrapping="Wrap" LineHeight="16"/>
                    </Grid>

                    <Separator Background="#EEEEEE" Margin="0,0,0,8"/>
                    
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="• Zero background memory when idle (0 MB RAM / 0% CPU)." FontSize="11" Foreground="#0067C0" Margin="0,1.5"/>
                        <TextBlock Text="• 100% local-first, offline, private (no cloud, no tracking)." FontSize="11" Foreground="#0067C0" Margin="0,1.5"/>
                        <TextBlock Text="• Direct Windows 11 context menu bypass (no 'Show more options')." FontSize="11" Foreground="#0067C0" Margin="0,1.5"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Row 3: Footer Actions -->
            <Grid Grid.Row="3" Margin="0,16,0,0">
                <Button Content="Show Sample Image in Explorer" HorizontalAlignment="Left" Click="BtnTestImage_Click" Padding="14,7" FontSize="12"/>
                <Button Content="Close" HorizontalAlignment="Right" Click="BtnClose_Click" MinWidth="80" Padding="14,7" FontSize="12"/>
            </Grid>
        </Grid>
    </Border>
</Window>
