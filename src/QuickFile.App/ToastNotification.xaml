<Window x:Class="QuickFile.App.ToastNotification"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickFile Notification" 
        Height="84" Width="410"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
        Loaded="Window_Loaded"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave">

    <Window.Resources>
        <Storyboard x:Key="CheckmarkAnim">
            <DoubleAnimation Storyboard.TargetName="CheckScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="0.2" To="1.0" Duration="0:0:0.35">
                <DoubleAnimation.EasingFunction>
                    <BackEase Amplitude="0.8" EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CheckScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="0.2" To="1.0" Duration="0:0:0.35">
                <DoubleAnimation.EasingFunction>
                    <BackEase Amplitude="0.8" EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="BadgeBorder"
                             Storyboard.TargetProperty="Opacity"
                             From="0.0" To="1.0" Duration="0:0:0.2"/>
        </Storyboard>
    </Window.Resources>
    
    <Border x:Name="MainContainer" Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="6" Opacity="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" Direction="270" ShadowDepth="4" Opacity="0.45" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Animated Success Circular Reveal Badge -->
            <Border x:Name="BadgeBorder" Grid.Column="0" Width="34" Height="34" CornerRadius="17" Background="#107C41" VerticalAlignment="Center" Margin="0,0,12,0" SnapsToDevicePixels="True">
                <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="1,1,0,0">
                    <Path x:Name="CheckPath" Data="M 2 7 L 6.5 11.5 L 14 3" 
                          Stroke="#FFFFFF" StrokeThickness="2.4" 
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <ScaleTransform x:Name="CheckScale" ScaleX="0" ScaleY="0"/>
                        </Path.RenderTransform>
                    </Path>
                </Viewbox>
            </Border>

            <!-- Notification Messages -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                <TextBlock x:Name="TxtTitle" Text="Operation Completed" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="TxtSubtitle" Text="Output file ready" FontSize="11" Foreground="#A8A8A8" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Action: Open File -->
            <Button x:Name="BtnOpenFile" Grid.Column="2" Content="Open File" Click="BtnOpenFile_Click" 
                    Background="#2D2D2D" Foreground="#E0E0E0" BorderBrush="#444444" BorderThickness="1"
                    Padding="9,4" Margin="4,0,3,0" FontSize="11" FontWeight="Medium" Cursor="Hand" VerticalAlignment="Center">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#3E3E3E"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Action: Open Folder -->
            <Button x:Name="BtnOpenFolder" Grid.Column="3" Content="Open Folder" Click="BtnOpenFolder_Click" 
                    Background="#262626" Foreground="#B0B0B0" BorderBrush="#3B3B3B" BorderThickness="1"
                    Padding="9,4" Margin="2,0,6,0" FontSize="11" FontWeight="Medium" Cursor="Hand" VerticalAlignment="Center">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#383838"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Close button -->
            <Button Grid.Column="4" Content="✕" Click="BtnClose_Click" 
                    Background="Transparent" Foreground="#777777" BorderThickness="0"
                    Width="24" Height="24" FontSize="11" Cursor="Hand" VerticalAlignment="Center">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#333333"/>
                                <Setter Property="Foreground" Value="#EEEEEE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</Window>
