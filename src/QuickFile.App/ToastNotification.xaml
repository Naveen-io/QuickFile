<Window x:Class="QuickFile.App.ToastNotification"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickFile Notification" 
        Height="88" Width="430"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
        Loaded="Window_Loaded"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave">

    <Window.Resources>
        <Storyboard x:Key="CheckmarkAnim">
            <DoubleAnimation Storyboard.TargetName="CheckScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="0.2" To="1.0" Duration="0:0:0.35">
                <DoubleAnimation.EasingFunction>
                    <BackEase Amplitude="0.8" EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CheckScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="0.2" To="1.0" Duration="0:0:0.35">
                <DoubleAnimation.EasingFunction>
                    <BackEase Amplitude="0.8" EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="BadgeBorder"
                             Storyboard.TargetProperty="Opacity"
                             From="0.0" To="1.0" Duration="0:0:0.2"/>
        </Storyboard>
    </Window.Resources>
    
    <Border x:Name="MainContainer" 
            Background="#1C1C1E" 
            BorderBrush="#38383A" 
            BorderThickness="1" 
            CornerRadius="16" 
            Padding="14,10" 
            Margin="8" 
            Opacity="0"
            MouseLeftButtonDown="Window_MouseLeftButtonDown"
            Cursor="SizeAll">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" Direction="270" ShadowDepth="4" Opacity="0.5" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Animated Success Circular Reveal Badge -->
            <Border x:Name="BadgeBorder" Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="#107C41" VerticalAlignment="Center" Margin="0,0,12,0" SnapsToDevicePixels="True">
                <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="1,1,0,0">
                    <Path x:Name="CheckPath" Data="M 2 7 L 6.5 11.5 L 14 3" 
                          Stroke="#FFFFFF" StrokeThickness="2.4" 
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <ScaleTransform x:Name="CheckScale" ScaleX="0" ScaleY="0"/>
                        </Path.RenderTransform>
                    </Path>
                </Viewbox>
            </Border>

            <!-- Notification Messages -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                <TextBlock x:Name="TxtTitle" Text="Operation Completed" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="TxtSubtitle" Text="Output file ready" FontSize="11" Foreground="#A0A0A0" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Action: Open File -->
            <Button x:Name="BtnOpenFile" Grid.Column="2" Content="Open File" Click="BtnOpenFile_Click" 
                    Background="#2C2C2E" Foreground="#F2F2F7" BorderBrush="#3A3A3C" BorderThickness="1"
                    Padding="11,5" Margin="4,0,3,0" FontSize="11" FontWeight="SemiBold" Cursor="Hand" VerticalAlignment="Center">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#3A3A3C"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Action: Open Folder -->
            <Button x:Name="BtnOpenFolder" Grid.Column="3" Content="Open Folder" Click="BtnOpenFolder_Click" 
                    Background="#242426" Foreground="#AEAEB2" BorderBrush="#333336" BorderThickness="1"
                    Padding="10,5" Margin="2,0,6,0" FontSize="11" FontWeight="Medium" Cursor="Hand" VerticalAlignment="Center">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#323235"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Close button -->
            <Button Grid.Column="4" Content="✕" Click="BtnClose_Click" 
                    Background="Transparent" Foreground="#8E8E93" BorderThickness="0"
                    Width="26" Height="26" FontSize="11" Cursor="Hand" VerticalAlignment="Center">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#3A3A3C"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</Window>
