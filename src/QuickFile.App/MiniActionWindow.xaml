<Window x:Class="QuickFile.App.MiniActionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickFile" 
        Width="430" SizeToContent="Height"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        Background="Transparent"
        Foreground="#1A1A1A"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
        WindowStyle="None"
        AllowsTransparency="True">
    
    <Window.Resources>
        <!-- Standard Button -->
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI, sans-serif"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D6D6D6"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#242424"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#F4F4F4"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#BFBFBF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#EAEAEA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Accent Button -->
        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#0067C0"/>
            <Setter Property="BorderBrush" Value="#005FB8"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#187BD0"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#1472C0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#005A9E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pill Chip Preset Button -->
        <Style x:Key="ChipBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Background" Value="#F1F3F5"/>
            <Setter Property="BorderBrush" Value="#E2E6EA"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#E4E8EC"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#D0D6DC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#D8DEE4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Fluent TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="tbBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tbBorder" Property="BorderBrush" Value="#A0A0A0"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="tbBorder" Property="BorderBrush" Value="#0067C0"/>
                                <Setter TargetName="tbBorder" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Fluent ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#202020"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" 
                                          Background="{TemplateBinding Background}" 
                                          BorderBrush="{TemplateBinding BorderBrush}" 
                                          BorderThickness="{TemplateBinding BorderThickness}" 
                                          Focusable="False" 
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="tb" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" SnapsToDevicePixels="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="24"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0" Stroke="#666666" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="tb" Property="BorderBrush" Value="#9E9E9E"/>
                                                <Setter TargetName="tb" Property="Background" Value="#FBFBFB"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="9,5,26,5" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="220">
                                    <Border x:Name="DropDownBorder" Background="#FFFFFF" BorderThickness="1" BorderBrush="#D0D0D0" CornerRadius="8" Margin="0,4,0,8">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="14" Direction="270" ShadowDepth="3" Opacity="0.18" Color="#000000"/>
                                        </Border.Effect>
                                        <ScrollViewer Margin="3" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Circular"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="30"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#0067C0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#222222"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="itemBorder" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#F0F4F8"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#E2EDF7"/>
                                <Setter Property="Foreground" Value="#005A9E"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Fluent Slider -->
        <Style TargetType="Slider">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="4" Background="#E3E5E8" CornerRadius="2" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" Background="#0067C0" CornerRadius="2"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Width="18" Height="18">
                                                    <Ellipse Fill="#FFFFFF" Stroke="#0067C0" StrokeThickness="4">
                                                        <Ellipse.Effect>
                                                            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.2" Direction="270"/>
                                                        </Ellipse.Effect>
                                                    </Ellipse>
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Fluent CheckBox -->
        <Style TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="chkBox" Width="16" Height="16" CornerRadius="4" BorderThickness="1.5" BorderBrush="#8A8A8A" Background="#FFFFFF" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path x:Name="chkMark" Visibility="Collapsed" Data="M 3 8 L 6.5 11.5 L 13 4" Stroke="#FFFFFF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="chkBox" Property="Background" Value="#0067C0"/>
                                <Setter TargetName="chkBox" Property="BorderBrush" Value="#0067C0"/>
                                <Setter TargetName="chkMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chkBox" Property="BorderBrush" Value="#0067C0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Elevated Window Container with True Rounded Corners & Move Support -->
    <Border x:Name="RootCard" 
            Background="#FFFFFF" 
            BorderBrush="#DCDCDC" 
            BorderThickness="1" 
            CornerRadius="16" 
            Padding="18" 
            Margin="10"
            MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" Direction="270" ShadowDepth="4" Opacity="0.22" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 0: Header & Move Target -->
                <RowDefinition Height="Auto"/> <!-- 1: File info badge -->
                <RowDefinition Height="Auto"/> <!-- 2: Action Panels -->
                <RowDefinition Height="Auto"/> <!-- 3: Success banner -->
                <RowDefinition Height="Auto"/> <!-- 4: Footer -->
            </Grid.RowDefinitions>

            <!-- Row 0: Draggable Title Bar with QuickFile Logo -->
            <Grid Grid.Row="0" Margin="0,0,0,12" Background="Transparent" Cursor="SizeAll">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- QuickFile Logo Badge -->
                    <Border Width="26" Height="26" CornerRadius="6" Background="#000000" Margin="0,0,8,0" VerticalAlignment="Center" SnapsToDevicePixels="True">
                        <Image Source="/assets/logo32.png" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TxtActionTitle" Text="QuickFile" FontSize="13" FontWeight="Bold" Foreground="#111111"/>
                    </StackPanel>
                </StackPanel>

                <!-- Close Button -->
                <Button Grid.Column="1" Content="✕" Click="BtnClose_Click" Width="28" Height="28" Padding="0"
                        Background="Transparent" BorderThickness="0" Foreground="#777777" FontSize="12" Margin="0" VerticalAlignment="Center" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="cb" Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="cb" Property="Background" Value="#F0F0F0"/>
                                    <Setter Property="Foreground" Value="#222222"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Row 1: File Info Card -->
            <Border Grid.Row="1" Background="#F8F9FA" BorderBrush="#E9ECEF" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Border Grid.Column="0" Width="30" Height="30" CornerRadius="6" Background="#E8F2FA" Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtFileCategoryIcon" Text="📄" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtFileName" Text="file_name.ext" FontSize="12" FontWeight="SemiBold" Foreground="#212529" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="TxtFileSpecs" Text="1.2 MB • Details" FontSize="11" Foreground="#6C757D" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Row 2: Action Panels -->
            <Grid Grid.Row="2" Margin="0,0,0,14">
                
                <!-- Panel 1: Compress Image -->
                <StackPanel x:Name="PanelCompress" Visibility="Collapsed">
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="Compression Quality" FontSize="12" FontWeight="SemiBold" Foreground="#333333"/>
                        <TextBlock x:Name="TxtQualityVal" Text="80%" HorizontalAlignment="Right" FontSize="12" FontWeight="Bold" Foreground="#0067C0"/>
                    </Grid>
                    <Slider x:Name="SliderQuality" Minimum="10" Maximum="100" Value="80" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="SliderQuality_ValueChanged" Margin="0,0,0,12"/>
                    
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="Output Format" FontSize="11" Foreground="#666666" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbCompressFormat" SelectedIndex="0">
                                <ComboBoxItem Content="WEBP (Smallest Size)"/>
                                <ComboBoxItem Content="JPEG (Universal)"/>
                                <ComboBoxItem Content="PNG (Lossless)"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtCompressEstimate" Text="Estimated: ~60% reduction" FontSize="11" Foreground="#107C41" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,14,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- Panel 2: Compress to Target Size -->
                <StackPanel x:Name="PanelCompressTarget" Visibility="Collapsed">
                    <TextBlock Text="Desired Target File Size" FontSize="12" FontWeight="SemiBold" Foreground="#333333" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtTargetSizeVal" Text="500" Grid.Column="0" Margin="0,0,6,0"/>
                        <ComboBox x:Name="CmbTargetUnit" Grid.Column="1" SelectedIndex="0">
                            <ComboBoxItem Content="KB"/>
                            <ComboBoxItem Content="MB"/>
                        </ComboBox>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Presets:" FontSize="11" Foreground="#707070" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Button Content="100 KB" Style="{StaticResource ChipBtn}" Click="PresetSize_Click" Tag="100"/>
                        <Button Content="250 KB" Style="{StaticResource ChipBtn}" Click="PresetSize_Click" Tag="250"/>
                        <Button Content="500 KB" Style="{StaticResource ChipBtn}" Click="PresetSize_Click" Tag="500"/>
                        <Button Content="1 MB" Style="{StaticResource ChipBtn}" Click="PresetSize_Click" Tag="1024"/>
                        <Button Content="2 MB" Style="{StaticResource ChipBtn}" Click="PresetSize_Click" Tag="2048"/>
                    </StackPanel>
                </StackPanel>

                <!-- Panel 3: Resize Image / Custom Dimensions -->
                <StackPanel x:Name="PanelResize" Visibility="Collapsed">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="Width (px)" FontSize="11" Foreground="#666666" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtResizeWidth" Text="1920" TextChanged="TxtResizeWidth_TextChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="Height (px)" FontSize="11" Foreground="#666666" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtResizeHeight" Text="1080" TextChanged="TxtResizeHeight_TextChanged"/>
                        </StackPanel>
                    </Grid>
                    <CheckBox x:Name="ChkKeepAspect" Content="🔒 Maintain original aspect ratio" IsChecked="True" FontSize="11" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Presets:" FontSize="11" Foreground="#707070" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Button Content="25%" Style="{StaticResource ChipBtn}" Click="PresetScale_Click" Tag="0.25"/>
                        <Button Content="50%" Style="{StaticResource ChipBtn}" Click="PresetScale_Click" Tag="0.5"/>
                        <Button Content="75%" Style="{StaticResource ChipBtn}" Click="PresetScale_Click" Tag="0.75"/>
                        <Button Content="1080p" Style="{StaticResource ChipBtn}" Click="PresetDim_Click" Tag="1920x1080"/>
                        <Button Content="720p" Style="{StaticResource ChipBtn}" Click="PresetDim_Click" Tag="1280x720"/>
                    </StackPanel>
                </StackPanel>

                <!-- Panel 4: Audio Options & Presets -->
                <StackPanel x:Name="PanelAudio" Visibility="Collapsed">
                    <TextBlock Text="Target Format &amp; Preset" FontSize="12" FontWeight="SemiBold" Foreground="#333333" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="Format" FontSize="11" Foreground="#666666" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbAudioFormat" SelectedIndex="0">
                                <ComboBoxItem Content="MP3 (Universal)"/>
                                <ComboBoxItem Content="WAV (Uncompressed)"/>
                                <ComboBoxItem Content="FLAC (Lossless)"/>
                                <ComboBoxItem Content="AAC (High Quality)"/>
                                <ComboBoxItem Content="M4A (Apple Audio)"/>
                                <ComboBoxItem Content="OGG (Vorbis)"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="Quality Preset" FontSize="11" Foreground="#666666" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbAudioPreset" SelectedIndex="1">
                                <ComboBoxItem Content="Smaller file (128 kbps)"/>
                                <ComboBoxItem Content="Balanced (192 kbps)"/>
                                <ComboBoxItem Content="High quality (320 kbps)"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- Advanced Audio Settings Expander -->
                    <Expander Header="Advanced Audio Settings" FontSize="11" Foreground="#555555" Margin="0,0,0,4">
                        <Border Background="#F8F9FA" BorderBrush="#E9ECEF" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,4,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="Sample Rate" FontSize="10" Foreground="#666666" Margin="0,0,0,3"/>
                                    <ComboBox x:Name="CmbAudioSampleRate" SelectedIndex="0" FontSize="11">
                                        <ComboBoxItem Content="Auto (Source)"/>
                                        <ComboBoxItem Content="44.1 kHz (CD Audio)"/>
                                        <ComboBoxItem Content="48.0 kHz (Studio)"/>
                                        <ComboBoxItem Content="96.0 kHz (Hi-Res)"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="Channels" FontSize="10" Foreground="#666666" Margin="0,0,0,3"/>
                                    <ComboBox x:Name="CmbAudioChannels" SelectedIndex="0" FontSize="11">
                                        <ComboBoxItem Content="Auto (Preserve)"/>
                                        <ComboBoxItem Content="Stereo (2 Channels)"/>
                                        <ComboBoxItem Content="Mono (1 Channel)"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Expander>
                </StackPanel>

                <!-- Panel 5: Video Options & Presets -->
                <StackPanel x:Name="PanelVideo" Visibility="Collapsed">
                    <TextBlock Text="Video Settings &amp; Format" FontSize="12" FontWeight="SemiBold" Foreground="#333333" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="Container Format" FontSize="11" Foreground="#666666" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbVideoFormat" SelectedIndex="0">
                                <ComboBoxItem Content="MP4 (H.264/AAC)"/>
                                <ComboBoxItem Content="MKV (Universal)"/>
                                <ComboBoxItem Content="WEBM (Web)"/>
                                <ComboBoxItem Content="MOV (QuickTime)"/>
                                <ComboBoxItem Content="AVI"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="Quality Preset" FontSize="11" Foreground="#666666" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbVideoPreset" SelectedIndex="1">
                                <ComboBoxItem Content="Smaller file (Compact)"/>
                                <ComboBoxItem Content="Balanced (Standard)"/>
                                <ComboBoxItem Content="High quality (Crisp)"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="Target Resolution" FontSize="11" Foreground="#666666" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbVideoResolution" SelectedIndex="0">
                                <ComboBoxItem Content="Original Resolution"/>
                                <ComboBoxItem Content="1080p Full HD (1920×1080)"/>
                                <ComboBoxItem Content="720p HD (1280×720)"/>
                                <ComboBoxItem Content="480p SD (854×480)"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,18,0,0" VerticalAlignment="Center">
                            <CheckBox x:Name="ChkExtractAudioOnly" Content="Extract Audio Only (MP3)"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- Panel 6: PDF Tools -->
                <StackPanel x:Name="PanelPdf" Visibility="Collapsed">
                    <TextBlock Text="PDF Action &amp; Parameters" FontSize="12" FontWeight="SemiBold" Foreground="#333333" Margin="0,0,0,6"/>
                    <ComboBox x:Name="CmbPdfAction" SelectedIndex="0" SelectionChanged="CmbPdfAction_SelectionChanged" Margin="0,0,0,10">
                        <ComboBoxItem Content="Convert to Images (PNG / JPG)"/>
                        <ComboBoxItem Content="Split into Individual 1-Page PDFs"/>
                        <ComboBoxItem Content="Extract Specific Pages (e.g. 1-3, 5)"/>
                        <ComboBoxItem Content="Rotate Pages"/>
                    </ComboBox>

                    <!-- Subpanel for Convert to Images -->
                    <StackPanel x:Name="SubPanelPdfImages" Visibility="Visible" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Image Format" FontSize="11" Foreground="#666666" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CmbPdfImgFormat" SelectedIndex="0">
                                    <ComboBoxItem Content="PNG (Lossless)"/>
                                    <ComboBoxItem Content="JPG (Standard)"/>
                                    <ComboBoxItem Content="WEBP (Modern)"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="Resolution (DPI)" FontSize="11" Foreground="#666666" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CmbPdfDpi" SelectedIndex="0">
                                    <ComboBoxItem Content="150 DPI (Balanced)"/>
                                    <ComboBoxItem Content="300 DPI (High Res / Print)"/>
                                    <ComboBoxItem Content="72 DPI (Screen)"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Subpanel for Extract Pages -->
                    <StackPanel x:Name="SubPanelPdfExtract" Visibility="Collapsed" Margin="0,0,0,6">
                        <TextBlock Text="Page Range to Extract (e.g. 1-3, 5, 8-10):" FontSize="11" Foreground="#666666" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtPdfPageRange" Text="1-2"/>
                    </StackPanel>

                    <!-- Subpanel for Rotate Pages -->
                    <StackPanel x:Name="SubPanelPdfRotate" Visibility="Collapsed" Margin="0,0,0,6">
                        <TextBlock Text="Rotation Angle:" FontSize="11" Foreground="#666666" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbPdfRotateAngle" SelectedIndex="0">
                            <ComboBoxItem Content="90° Clockwise"/>
                            <ComboBoxItem Content="180° Flip"/>
                            <ComboBoxItem Content="270° (90° Counter-Clockwise)"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>

                <!-- Panel 7: File Information Card -->
                <StackPanel x:Name="PanelInfo" Visibility="Collapsed">
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="24"/>
                            <RowDefinition Height="24"/>
                            <RowDefinition Height="24"/>
                            <RowDefinition Height="24"/>
                            <RowDefinition Height="24"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Format:" FontSize="11" Foreground="#666666"/>
                        <TextBlock x:Name="InfoFormat" Grid.Row="0" Grid.Column="1" Text="PNG" FontSize="11" FontWeight="SemiBold"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Specs / Dim:" FontSize="11" Foreground="#666666"/>
                        <TextBlock x:Name="InfoDimensions" Grid.Row="1" Grid.Column="1" Text="1920 × 1080 px" FontSize="11" FontWeight="SemiBold"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Duration / Extra:" FontSize="11" Foreground="#666666"/>
                        <TextBlock x:Name="InfoExtra" Grid.Row="2" Grid.Column="1" Text="N/A" FontSize="11" FontWeight="SemiBold"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="File Size:" FontSize="11" Foreground="#666666"/>
                        <TextBlock x:Name="InfoSize" Grid.Row="3" Grid.Column="1" Text="1.45 MB" FontSize="11" FontWeight="SemiBold"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Modified:" FontSize="11" Foreground="#666666"/>
                        <TextBlock x:Name="InfoModified" Grid.Row="4" Grid.Column="1" Text="Just now" FontSize="11"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Path:" FontSize="11" Foreground="#666666" Margin="0,4,0,0"/>
                        <TextBlock x:Name="InfoPath" Grid.Row="5" Grid.Column="1" Text="C:\path\..." FontSize="10" Foreground="#555555" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- Row 3: Result / Success Banner -->
            <Border x:Name="BannerSuccess" Grid.Row="3" Background="#EDF7ED" BorderBrush="#C6E7C7" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,0,14" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="✓" Foreground="#107C41" FontWeight="Bold" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtSuccessMsg" Text="Operation completed successfully!" FontSize="11" FontWeight="SemiBold" Foreground="#107C41"/>
                        <TextBlock x:Name="TxtSuccessDetail" Text="Saved to output file" FontSize="10" Foreground="#2A6E3B" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button x:Name="BtnSuccessOpen" Grid.Column="2" Content="Show in Folder" Click="BtnSuccessOpen_Click" Style="{StaticResource ChipBtn}" Background="#FFFFFF" Margin="6,0,0,0"/>
                </Grid>
            </Border>

            <!-- Row 4: Action Footer -->
            <Grid Grid.Row="4">
                <Button x:Name="BtnSecondary" Content="Cancel" Click="BtnClose_Click" HorizontalAlignment="Left" MinWidth="80"/>
                <Button x:Name="BtnPrimary" Content="Execute" Style="{StaticResource PrimaryBtn}" Click="BtnPrimary_Click" HorizontalAlignment="Right" MinWidth="115"/>
            </Grid>
        </Grid>
    </Border>
</Window>
