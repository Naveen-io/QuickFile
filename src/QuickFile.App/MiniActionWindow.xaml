<Window x:Class="QuickFile.App.MiniActionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickFile" 
        Width="420" SizeToContent="Height"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        Background="#FBFBFB"
        Foreground="#1A1A1A"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
        WindowStyle="None"
        AllowsTransparency="True">
    
    <Window.Resources>
        <!-- Standard Button -->
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI, sans-serif"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#242424"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#F3F3F3"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#BDBDBD"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#E5E5E5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Accent Button -->
        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#0067C0"/>
            <Setter Property="BorderBrush" Value="#005FB8"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#187BD0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#005A9E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Quick Chip Button -->
        <Style x:Key="ChipBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CECECE"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#C7C7C7" BorderThickness="1" CornerRadius="12" Background="#FBFBFB" Padding="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" Direction="270" ShadowDepth="4" Opacity="0.22" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 0: Title Bar -->
                <RowDefinition Height="Auto"/> <!-- 1: File info chip -->
                <RowDefinition Height="Auto"/> <!-- 2: Action Panels -->
                <RowDefinition Height="Auto"/> <!-- 3: Success banner -->
                <RowDefinition Height="Auto"/> <!-- 4: Footer -->
            </Grid.RowDefinitions>

            <!-- Row 0: Title Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚡" FontSize="14" Foreground="#0067C0" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtActionTitle" Text="QuickFile" FontSize="14" FontWeight="Bold" Foreground="#111111" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1" Content="✕" Click="BtnClose_Click" Width="26" Height="26" Padding="0"
                        Background="Transparent" BorderThickness="0" Foreground="#666666" FontSize="12" Margin="0" VerticalAlignment="Center"/>
            </Grid>

            <!-- Row 1: File Info Chip -->
            <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#EAEAEA" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,0,14">
                <Grid>
                    <StackPanel>
                        <TextBlock x:Name="TxtFileName" Text="file_name.ext" FontSize="12" FontWeight="SemiBold" Foreground="#222222" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="TxtFileSpecs" Text="1.2 MB • Details" FontSize="11" Foreground="#707070" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Row 2: Action Panels -->
            <Grid Grid.Row="2" Margin="0,0,0,14">
                
                <!-- Panel 1: Compress Image -->
                <StackPanel x:Name="PanelCompress" Visibility="Collapsed">
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="Compression Quality" FontSize="12" FontWeight="SemiBold" Foreground="#333333"/>
                        <TextBlock x:Name="TxtQualityVal" Text="80%" HorizontalAlignment="Right" FontSize="12" FontWeight="Bold" Foreground="#0067C0"/>
                    </Grid>
                    <Slider x:Name="SliderQuality" Minimum="10" Maximum="100" Value="80" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="SliderQuality_ValueChanged" Margin="0,0,0,10"/>
                    
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="Output Format" FontSize="11" Foreground="#666666" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbCompressFormat" SelectedIndex="0" Padding="6,4">
                                <ComboBoxItem Content="WEBP (Smallest Size)"/>
                                <ComboBoxItem Content="JPEG (Universal)"/>
                                <ComboBoxItem Content="PNG (Lossless)"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtCompressEstimate" Text="Estimated: ~60% reduction" FontSize="11" Foreground="#107C41" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,14,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- Panel 2: Compress to Target Size -->
                <StackPanel x:Name="PanelCompressTarget" Visibility="Collapsed">
                    <TextBlock Text="Desired Target File Size" FontSize="12" FontWeight="SemiBold" Foreground="#333333" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtTargetSizeVal" Text="500" Grid.Column="0" Margin="0,0,6,0"/>
                        <ComboBox x:Name="CmbTargetUnit" Grid.Column="1" SelectedIndex="0" Padding="6,4">
                            <ComboBoxItem Content="KB"/>
                            <ComboBoxItem Content="MB"/>
                        </ComboBox>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Presets:" FontSize="11" Foreground="#707070" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Button Content="100 KB" Style="{StaticResource ChipBtn}" Click="PresetSize_Click" Tag="100"/>
                        <Button Content="250 KB" Style="{StaticResource ChipBtn}" Click="PresetSize_Click" Tag="250"/>
                        <Button Content="500 KB" Style="{StaticResource ChipBtn}" Click="PresetSize_Click" Tag="500"/>
                        <Button Content="1 MB" Style="{StaticResource ChipBtn}" Click="PresetSize_Click" Tag="1024"/>
                        <Button Content="2 MB" Style="{StaticResource ChipBtn}" Click="PresetSize_Click" Tag="2048"/>
                    </StackPanel>
                </StackPanel>

                <!-- Panel 3: Resize Image / Custom Dimensions -->
                <StackPanel x:Name="PanelResize" Visibility="Collapsed">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="Width (px)" FontSize="11" Foreground="#666666" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtResizeWidth" Text="1920" TextChanged="TxtResizeWidth_TextChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="Height (px)" FontSize="11" Foreground="#666666" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtResizeHeight" Text="1080" TextChanged="TxtResizeHeight_TextChanged"/>
                        </StackPanel>
                    </Grid>
                    <CheckBox x:Name="ChkKeepAspect" Content="🔒 Maintain original aspect ratio" IsChecked="True" FontSize="11" Foreground="#444444" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Presets:" FontSize="11" Foreground="#707070" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Button Content="25%" Style="{StaticResource ChipBtn}" Click="PresetScale_Click" Tag="0.25"/>
                        <Button Content="50%" Style="{StaticResource ChipBtn}" Click="PresetScale_Click" Tag="0.5"/>
                        <Button Content="75%" Style="{StaticResource ChipBtn}" Click="PresetScale_Click" Tag="0.75"/>
                        <Button Content="1080p" Style="{StaticResource ChipBtn}" Click="PresetDim_Click" Tag="1920x1080"/>
                        <Button Content="720p" Style="{StaticResource ChipBtn}" Click="PresetDim_Click" Tag="1280x720"/>
                    </StackPanel>
                </StackPanel>

                <!-- Panel 4: Audio Options & Presets -->
                <StackPanel x:Name="PanelAudio" Visibility="Collapsed">
                    <TextBlock Text="Target Format &amp; Preset" FontSize="12" FontWeight="SemiBold" Foreground="#333333" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="Format" FontSize="11" Foreground="#666666" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbAudioFormat" SelectedIndex="0" Padding="6,4">
                                <ComboBoxItem Content="MP3 (Universal)"/>
                                <ComboBoxItem Content="WAV (Uncompressed)"/>
                                <ComboBoxItem Content="FLAC (Lossless)"/>
                                <ComboBoxItem Content="AAC (High Quality)"/>
                                <ComboBoxItem Content="M4A (Apple Audio)"/>
                                <ComboBoxItem Content="OGG (Vorbis)"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="Quality Preset" FontSize="11" Foreground="#666666" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbAudioPreset" SelectedIndex="1" Padding="6,4">
                                <ComboBoxItem Content="Smaller file (128 kbps)"/>
                                <ComboBoxItem Content="Balanced (192 kbps)"/>
                                <ComboBoxItem Content="High quality (320 kbps)"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- Advanced Audio Settings Expander -->
                    <Expander Header="Advanced Audio Settings" FontSize="11" Foreground="#555555" Margin="0,0,0,4">
                        <Border Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,4,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Text="Sample Rate" FontSize="10" Foreground="#666666" Margin="0,0,0,2"/>
                                    <ComboBox x:Name="CmbAudioSampleRate" SelectedIndex="0" Padding="4,2" FontSize="11">
                                        <ComboBoxItem Content="Auto (Source)"/>
                                        <ComboBoxItem Content="44.1 kHz (CD Audio)"/>
                                        <ComboBoxItem Content="48.0 kHz (Studio)"/>
                                        <ComboBoxItem Content="96.0 kHz (Hi-Res)"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                    <TextBlock Text="Channels" FontSize="10" Foreground="#666666" Margin="0,0,0,2"/>
                                    <ComboBox x:Name="CmbAudioChannels" SelectedIndex="0" Padding="4,2" FontSize="11">
                                        <ComboBoxItem Content="Auto (Preserve)"/>
                                        <ComboBoxItem Content="Stereo (2 Channels)"/>
                                        <ComboBoxItem Content="Mono (1 Channel)"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Expander>
                </StackPanel>

                <!-- Panel 5: Video Options & Presets -->
                <StackPanel x:Name="PanelVideo" Visibility="Collapsed">
                    <TextBlock Text="Video Settings &amp; Format" FontSize="12" FontWeight="SemiBold" Foreground="#333333" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="Container Format" FontSize="11" Foreground="#666666" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbVideoFormat" SelectedIndex="0" Padding="6,4">
                                <ComboBoxItem Content="MP4 (H.264/AAC)"/>
                                <ComboBoxItem Content="MKV (Universal)"/>
                                <ComboBoxItem Content="WEBM (Web)"/>
                                <ComboBoxItem Content="MOV (QuickTime)"/>
                                <ComboBoxItem Content="AVI"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="Quality Preset" FontSize="11" Foreground="#666666" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbVideoPreset" SelectedIndex="1" Padding="6,4">
                                <ComboBoxItem Content="Smaller file (Compact)"/>
                                <ComboBoxItem Content="Balanced (Standard)"/>
                                <ComboBoxItem Content="High quality (Crisp)"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="Target Resolution" FontSize="11" Foreground="#666666" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbVideoResolution" SelectedIndex="0" Padding="6,4">
                                <ComboBoxItem Content="Original Resolution"/>
                                <ComboBoxItem Content="1080p Full HD (1920×1080)"/>
                                <ComboBoxItem Content="720p HD (1280×720)"/>
                                <ComboBoxItem Content="480p SD (854×480)"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,18,0,0" VerticalAlignment="Center">
                            <CheckBox x:Name="ChkExtractAudioOnly" Content="Extract Audio Only (MP3)" FontSize="11" Foreground="#333333"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- Panel 6: PDF Tools -->
                <StackPanel x:Name="PanelPdf" Visibility="Collapsed">
                    <TextBlock Text="PDF Action &amp; Parameters" FontSize="12" FontWeight="SemiBold" Foreground="#333333" Margin="0,0,0,6"/>
                    <ComboBox x:Name="CmbPdfAction" SelectedIndex="0" SelectionChanged="CmbPdfAction_SelectionChanged" Padding="6,4" Margin="0,0,0,10">
                        <ComboBoxItem Content="Convert to Images (PNG / JPG)"/>
                        <ComboBoxItem Content="Split into Individual 1-Page PDFs"/>
                        <ComboBoxItem Content="Extract Specific Pages (e.g. 1-3, 5)"/>
                        <ComboBoxItem Content="Rotate Pages"/>
                    </ComboBox>

                    <!-- Subpanel for Convert to Images -->
                    <StackPanel x:Name="SubPanelPdfImages" Visibility="Visible" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Image Format" FontSize="11" Foreground="#666666" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CmbPdfImgFormat" SelectedIndex="0" Padding="6,4">
                                    <ComboBoxItem Content="PNG (Lossless)"/>
                                    <ComboBoxItem Content="JPG (Standard)"/>
                                    <ComboBoxItem Content="WEBP (Modern)"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="Resolution (DPI)" FontSize="11" Foreground="#666666" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CmbPdfDpi" SelectedIndex="0" Padding="6,4">
                                    <ComboBoxItem Content="150 DPI (Balanced)"/>
                                    <ComboBoxItem Content="300 DPI (High Res / Print)"/>
                                    <ComboBoxItem Content="72 DPI (Screen)"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Subpanel for Extract Pages -->
                    <StackPanel x:Name="SubPanelPdfExtract" Visibility="Collapsed" Margin="0,0,0,6">
                        <TextBlock Text="Page Range to Extract (e.g. 1-3, 5, 8-10):" FontSize="11" Foreground="#666666" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtPdfPageRange" Text="1-2"/>
                    </StackPanel>

                    <!-- Subpanel for Rotate Pages -->
                    <StackPanel x:Name="SubPanelPdfRotate" Visibility="Collapsed" Margin="0,0,0,6">
                        <TextBlock Text="Rotation Angle:" FontSize="11" Foreground="#666666" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbPdfRotateAngle" SelectedIndex="0" Padding="6,4">
                            <ComboBoxItem Content="90° Clockwise"/>
                            <ComboBoxItem Content="180° Flip"/>
                            <ComboBoxItem Content="270° (90° Counter-Clockwise)"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>

                <!-- Panel 7: File Information Card -->
                <StackPanel x:Name="PanelInfo" Visibility="Collapsed">
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Format:" FontSize="11" Foreground="#666666"/>
                        <TextBlock x:Name="InfoFormat" Grid.Row="0" Grid.Column="1" Text="PNG" FontSize="11" FontWeight="SemiBold"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Specs / Dim:" FontSize="11" Foreground="#666666"/>
                        <TextBlock x:Name="InfoDimensions" Grid.Row="1" Grid.Column="1" Text="1920 × 1080 px" FontSize="11" FontWeight="SemiBold"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Duration / Extra:" FontSize="11" Foreground="#666666"/>
                        <TextBlock x:Name="InfoExtra" Grid.Row="2" Grid.Column="1" Text="N/A" FontSize="11" FontWeight="SemiBold"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="File Size:" FontSize="11" Foreground="#666666"/>
                        <TextBlock x:Name="InfoSize" Grid.Row="3" Grid.Column="1" Text="1.45 MB" FontSize="11" FontWeight="SemiBold"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Modified:" FontSize="11" Foreground="#666666"/>
                        <TextBlock x:Name="InfoModified" Grid.Row="4" Grid.Column="1" Text="Just now" FontSize="11"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Path:" FontSize="11" Foreground="#666666" Margin="0,4,0,0"/>
                        <TextBlock x:Name="InfoPath" Grid.Row="5" Grid.Column="1" Text="C:\path\..." FontSize="10" Foreground="#555555" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- Row 3: Result / Success Banner -->
            <Border x:Name="BannerSuccess" Grid.Row="3" Background="#EDF7ED" BorderBrush="#C6E7C7" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,14" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="✓" Foreground="#107C41" FontWeight="Bold" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtSuccessMsg" Text="Operation completed successfully!" FontSize="11" FontWeight="SemiBold" Foreground="#107C41"/>
                        <TextBlock x:Name="TxtSuccessDetail" Text="Saved to output file" FontSize="10" Foreground="#2A6E3B" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button x:Name="BtnSuccessOpen" Grid.Column="2" Content="Show in Folder" Click="BtnSuccessOpen_Click" Style="{StaticResource ChipBtn}" Background="#FFFFFF" Margin="6,0,0,0"/>
                </Grid>
            </Border>

            <!-- Row 4: Action Footer -->
            <Grid Grid.Row="4">
                <Button x:Name="BtnSecondary" Content="Cancel" Click="BtnClose_Click" HorizontalAlignment="Left" MinWidth="75"/>
                <Button x:Name="BtnPrimary" Content="Execute" Style="{StaticResource PrimaryBtn}" Click="BtnPrimary_Click" HorizontalAlignment="Right" MinWidth="110"/>
            </Grid>
        </Grid>
    </Border>
</Window>
