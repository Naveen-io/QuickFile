<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\QuickFile.Core\QuickFile.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyName>QuickFile</AssemblyName>
    <RootNamespace>QuickFile.App</RootNamespace>
    <Product>QuickFile</Product>
    <Title>QuickFile</Title>
    <Description>Quick file actions, right from Windows File Explorer.</Description>
    <Version>1.1.0</Version>
    <Authors>Naveen-io</Authors>
    <RepositoryUrl>https://github.com/Naveen-io/QuickFile</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
    <Resource Include="assets\logo.png" />
    <Resource Include="assets\logo32.png" />
    <Resource Include="assets\logo48.png" />
  </ItemGroup>

</Project>
